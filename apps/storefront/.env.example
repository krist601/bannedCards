# Default is medusa. Set explicitly to demo for the local preview.
NEXT_PUBLIC_COMMERCE_MODE=medusa
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000
# A publishable Store API key, never an admin/secret key.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# A region configured with currency CLP and Chile as a country.
NEXT_PUBLIC_MEDUSA_REGION_ID=

# Contact email shown in the footer and legal pages (defaults to info@bannedcards.cl)
NEXT_PUBLIC_CONTACT_EMAIL=
# Instagram profile linked from the footer (defaults to https://www.instagram.com/bannedcards.cl/)
NEXT_PUBLIC_INSTAGRAM_URL=
